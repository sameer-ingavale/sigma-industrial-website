# Copy this file to .env.local for local development.
# In production, set these in Vercel: Project Settings → Environment Variables.

# API key from https://resend.com — free tier covers low-volume enquiry email.
RESEND_API_KEY=

# Where enquiry form submissions are sent. Defaults to siteConfig.contactEmail
# in lib/site-config.js if not set.
ENQUIRY_TO_EMAIL=enquiries@sigmaindustrial.co.in

# Google Analytics 4 Measurement ID (starts with "G-"). Leave blank until
# you've set up a GA4 property — see "Google Analytics" in README.md.
# Must be prefixed NEXT_PUBLIC_ so the browser-side script can read it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
